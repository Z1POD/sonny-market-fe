# Backend REST API (Buyer Frontend API contract). Either the origin or the full root works;
# "/api/v1" is appended when missing.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public URL of THIS app (SEO / Open Graph)
VITE_APP_URL=https://shop.example.com

# Telegram Mini App bot handle (without @) — used for the "Open in Telegram" sign-in link
VITE_MINIAPP_HANDLE=your_buyer_bot

# Optional: URL of the separate creator/designer app (adds a "Start selling" link to the account menu)
VITE_CREATOR_APP_URL=

# Optional: JSON map of 3D environment HDR files, e.g. {"studio":"https://.../studio.hdr"}.
# When unset the studio is lit by its built-in lights only (no HDR is fetched).
VITE_STUDIO_ENV_FILES={}
